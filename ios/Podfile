# Do NOT use global use_modular_headers! here. AsyncStorage 3.x needs Swift, but
# global modular headers make React-RuntimeCore and React-jsitooling both expose
# module react_runtime, which breaks the build on Xcode 26 (RN 0.79 + New Arch).

# Prefer git Specs when cdn.cocoapods.org returns 403 (common on some networks).
# source 'https://cdn.cocoapods.org/'
# Fallback if CDN is blocked: comment the line above and uncomment:
source 'https://github.com/CocoaPods/Specs.git'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase: skip Xcode SPM (often hangs / fails) and use CocoaPods.
$RNFirebaseDisableSPM = true
$RNFirebaseAsStaticFramework = true

# Required for firebase-ios-sdk via CocoaPods with RN Firebase.
use_frameworks! :linkage => :static

# Xcode 26 + fmt 11.0.2 (RN 0.79): disable consteval that Apple Clang rejects.
def patch_fmt_for_xcode26(installer)
  fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
  return unless File.exist?(fmt_base)

  content = File.read(fmt_base)
  return if content.include?('Xcode 26 workaround')

  patched = content.gsub(
    /^(#elif defined\(__cpp_consteval\)\n#\s*define FMT_USE_CONSTEVAL) 1/,
    "// Xcode 26 workaround: disable consteval\n\\1 0"
  )
  return if patched == content

  File.chmod(0644, fmt_base)
  File.write(fmt_base, patched)
  Pod::UI.puts 'Patched fmt/base.h for Xcode 26 (FMT_USE_CONSTEVAL=0)'.green
end

# RN shell phases use `/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT"` which breaks when the
# repo path contains spaces (e.g. "TF PMS").
def fix_rn_script_phases(project)
  project.targets.each do |target|
    target.shell_script_build_phases.each do |phase|
      script = phase.shell_script
      next if script.nil? || script.empty?

      fixed = script
        .gsub('/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT"',
              '"$WITH_ENVIRONMENT" "$SCRIPT_PHASES_SCRIPT"')
        .gsub('/bin/sh -c "$WITH_ENVIRONMENT $REACT_NATIVE_XCODE"',
              '"$WITH_ENVIRONMENT" "$REACT_NATIVE_XCODE"')

      phase.shell_script = fixed if fixed != script
    end
  end
  project.save
end

# with-environment.sh runs `$1` unquoted, which breaks when the repo path has spaces.
def patch_with_environment_for_spaces(react_native_path)
  script = File.join(react_native_path, 'scripts/xcode/with-environment.sh')
  return unless File.exist?(script)

  content = File.read(script)
  return if content.include?('path spaces workaround')

  patched = content.gsub(
    "# Execute argument, if present\nif [ -n \"$1\" ]; then\n  $1\nfi",
    "# Execute argument, if present (path spaces workaround)\nif [ $# -gt 0 ]; then\n  \"$@\"\nfi"
  )
  return if patched == content

  File.chmod(0755, script)
  File.write(script, patched)
  Pod::UI.puts 'Patched with-environment.sh for paths with spaces'.green
end

# Hermes replace script runs `tar -xf $path` unquoted; spaces in the repo path break Archive.
def patch_hermes_replace_for_spaces(react_native_path)
  script = File.join(react_native_path, 'sdks/hermes-engine/utils/replace_hermes_version.js')
  return unless File.exist?(script)

  content = File.read(script)
  return if content.include?('JSON.stringify(tarballURLPath)')

  unless content.include?('tar -xf ${tarballURLPath} -C ${finalLocation}')
    Pod::UI.puts 'Hermes replace script already uses a different tar invocation; skip space patch'.yellow
    return
  end

  patched = content.gsub(
    'execSync(`tar -xf ${tarballURLPath} -C ${finalLocation}`);',
    <<~JS.strip
      // Quote paths: repo folders with spaces (e.g. "TF PMS") break unquoted tar args.
        execSync(`tar -xf ${JSON.stringify(tarballURLPath)} -C ${JSON.stringify(finalLocation)}`);
    JS
  )
  return if patched == content

  File.chmod(0644, script)
  File.write(script, patched)
  Pod::UI.puts 'Patched replace_hermes_version.js for paths with spaces'.green
end

target 'BaseCrewMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )


  
  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    patch_fmt_for_xcode26(installer)
    patch_with_environment_for_spaces(config[:reactNativePath])
    patch_hermes_replace_for_spaces(config[:reactNativePath])
    fix_rn_script_phases(installer.pods_project)

    app_project_path = File.join(__dir__, 'BaseCrewMobile.xcodeproj')
    fix_rn_script_phases(Xcodeproj::Project.open(app_project_path))

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        # Xcode 26: avoid explicit Swift modules conflicting with RN pod module maps.
        cfg.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end

      if target.name == 'AsyncStorage'
        target.build_configurations.each do |cfg|
          # Swift in AsyncStorage does `import React` without global use_modular_headers!
          cfg.build_settings['DEFINES_MODULE'] = 'YES'
        end
      end

      if target.name == 'fmt'
        target.build_configurations.each do |cfg|
          cfg.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
